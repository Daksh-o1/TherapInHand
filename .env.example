# Core app
FLASK_ENV=development
DEBUG=1
PORT=5000
FLASK_SECRET_KEY=replace-with-a-long-random-secret
ADMIN_KEY=replace-with-a-separate-admin-key
DATABASE_URL=sqlite:///D:/mini project/data/therapinhand.sqlite3

# Sessions and cookies
SESSION_COOKIE_NAME=therapinhand_session
SESSION_COOKIE_SECURE=0
SESSION_COOKIE_SAMESITE=Lax
REMEMBER_COOKIE_SECURE=0
REMEMBER_COOKIE_SAMESITE=Lax
SESSION_LIFETIME_SECONDS=604800
REMEMBER_COOKIE_DURATION_SECONDS=2592000
SESSION_REFRESH_EACH_REQUEST=1

# Request safety
MAX_CONTENT_LENGTH=1048576
TRUSTED_HOSTS=localhost,127.0.0.1
ENABLE_PROXY_FIX=1
PROXY_FIX_X_FOR=1
PROXY_FIX_X_PROTO=1
PROXY_FIX_X_HOST=1
PROXY_FIX_X_PORT=1
PROXY_FIX_X_PREFIX=1
ENABLE_CORS=1
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
PREFERRED_URL_SCHEME=http

# Database and legacy chat import fallback
DB_POOL_RECYCLE_SECONDS=1800
LEGACY_CHAT_DB_ENABLED=0

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/therapinhand.log
LOG_MAX_BYTES=1048576
LOG_BACKUP_COUNT=5

# OpenRouter
OPENROUTER_API_KEY=
USE_OPENROUTER_CHAT=0
OPENROUTER_MODEL=openrouter/auto
OPENROUTER_MAX_TOKENS=240
OPENROUTER_TEMPERATURE=0.55
OPENROUTER_SITE_URL=http://localhost:5000
OPENROUTER_APP_NAME=TherapInHand
OPENROUTER_TIMEOUT=45
OPENROUTER_MAX_RETRIES=2
OPENROUTER_RETRY_BACKOFF_SECONDS=1.5
